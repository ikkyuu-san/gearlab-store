generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String
  category        String
  brand           String?
  sku             String?            @unique
  priceMMK        Int
  imageUrl        String?
  imageAlt        String?
  imageStorageKey String?
  stockStatus     ProductStockStatus @default(PREORDER)
  stockQuantity   Int?
  preorderLimit   Int?
  preorderEta     DateTime?          @db.Date
  featured        Boolean            @default(false)
  active          Boolean            @default(true)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orderItems      OrderItem[]
  specifications  ProductSpecification[]

  @@index([category])
  @@index([featured])
  @@index([stockStatus])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Order {
  id                String         @id @default(cuid())
  customerName      String
  phone             String
  contactMethod     ContactMethod?
  shippingAddress   String?
  totalAmount       Int?
  currency          OrderCurrency @default(THB)
  status            OrderStatus    @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  checkoutToken     String         @unique
  deliveryAddress   String
  email             String?
  note              String?
  orderNumber       String         @unique
  subtotal          Int
  deliveryMethod    DeliveryMethod @default(STANDARD)
  paymentStatus     PaymentStatus  @default(UNPAID)
  publicAccessToken String?        @unique
  items             OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  priceSnapshot       Int
  lineTotal           Int
  productNameSnapshot String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
}

enum ProductStockStatus {
  PREORDER
  IN_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ContactMethod {
  PHONE
  FACEBOOK
  VIBER
  TELEGRAM
}

enum DeliveryMethod {
  STANDARD
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderCurrency {
  MMK
  THB
}
