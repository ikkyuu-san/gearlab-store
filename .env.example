# PostgreSQL connection string for local development or a hosted PostgreSQL service.
# Keep the real value in .env, which is ignored by Git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gearlab?schema=public"

# Auth.js session signing secret. Generate locally; never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only by the local admin bootstrap script. Never commit these values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Required for production-safe serverless rate limiting (Upstash Redis REST API).
# Local development may run without these values; production rejects protected
# login/order requests until both values are configured.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
